#!/usr/bin/env node
// fake-gh: a stand-in for the GitHub CLI inside an eval run. It answers the
// commands ship-changes uses from a JSON state file, checks pushes against the
// fixture's local remote, and logs every call so checks can read what the agent did.
//
// EVAL_GH_STATE  directory holding state.json (seeded by the scenario) and calls.jsonl
"use strict";
const fs = require("fs");
const path = require("path");
const { execFileSync, spawnSync } = require("child_process");

const dir = process.env.EVAL_GH_STATE;
if (!dir) { process.stderr.write("fake-gh: EVAL_GH_STATE is not set\n"); process.exit(4); }
const statePath = path.join(dir, "state.json");
const state = JSON.parse(fs.readFileSync(statePath, "utf8"));
const argv = process.argv.slice(2);

let stdinText = "";
function readStdin() { try { return fs.readFileSync(0, "utf8"); } catch { return ""; } }

function finish(code, out, err) {
  if (out) process.stdout.write(out.endsWith("\n") ? out : out + "\n");
  if (err) process.stderr.write(err.endsWith("\n") ? err : err + "\n");
  fs.appendFileSync(path.join(dir, "calls.jsonl"),
    JSON.stringify({ argv, cwd: process.cwd(), exit: code, stdin: stdinText || undefined }) + "\n");
  fs.writeFileSync(statePath, JSON.stringify(state, null, 2));
  process.exit(code);
}

// Flags that take a value; everything else starting with - is boolean.
const VALUE_FLAGS = new Set(["--json", "--jq", "-q", "--template", "-t", "--title", "-b", "--body",
  "-F", "--body-file", "-B", "--base", "-H", "--head", "--attach", "-l", "--label", "--add-label",
  "-a", "--assignee", "-r", "--reviewer", "-s", "--state", "-S", "--search", "-L", "--limit",
  "-R", "--repo", "-X", "--method", "-f", "--raw-field", "--field", "-m", "--milestone",
  "--remove-label", "--interval", "-i", "--author", "-A"]);
for (const f of ["--parent", "--blocked-by", "--blocking", "--add-blocked-by", "--add-blocking", "--type", "--project", "--add-project",
  "--remove-project", "--sort", "--order", "--match", "--owner", "--remote", "--merge-method", "--message"]) VALUE_FLAGS.add(f);

function parse(args) {
  const flags = {}; const pos = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith("--") && a.includes("=")) {
      const k = a.slice(0, a.indexOf("=")); (flags[k] = flags[k] || []).push(a.slice(a.indexOf("=") + 1));
    } else if (VALUE_FLAGS.has(a)) {
      (flags[a] = flags[a] || []).push(args[++i]);
    } else if (a.startsWith("-") && a !== "-") {
      (flags[a] = flags[a] || []).push(true);
    } else pos.push(a);
  }
  const get = (...names) => { for (const n of names) if (flags[n]) return flags[n][flags[n].length - 1]; return undefined; };
  const all = (...names) => names.flatMap((n) => flags[n] || []);
  const has = (...names) => names.some((n) => flags[n]);
  return { flags, pos, get, all, has };
}

function git(...args) {
  try { return execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim(); }
  catch { return ""; }
}
const currentBranch = () => git("branch", "--show-current");
const remoteHead = (branch) => (git("ls-remote", "--heads", "origin", branch).split(/\s+/)[0] || "");

// Output JSON, narrowed to --json fields and filtered through --jq like gh does.
function emit(p, value, textFallback) {
  const fields = p.get("--json");
  const jq = p.get("--jq", "-q");
  if (fields === undefined && jq === undefined) return finish(0, textFallback !== undefined ? textFallback : JSON.stringify(value, null, 2));
  let v = value;
  if (fields && fields !== true) {
    const keys = fields.split(",").map((s) => s.trim()).filter(Boolean);
    const pick = (o) => Object.fromEntries(keys.map((k) => [k, o[k] === undefined ? null : o[k]]));
    v = Array.isArray(value) ? value.map(pick) : pick(value);
  }
  if (!jq) return finish(0, JSON.stringify(v, null, 2));
  const r = spawnSync("jq", ["-r", jq], { input: JSON.stringify(v), encoding: "utf8" });
  if (r.status !== 0) return finish(1, "", `failed to parse jq expression (line 1, column 1)\n${r.stderr}`);
  return finish(0, r.stdout.replace(/\n$/, ""));
}

const repo = state.repo;
const repoUrl = `https://github.com/${repo.nameWithOwner}`;
const prUrl = (n) => `${repoUrl}/pull/${n}`;

function prJson(pr) {
  return {
    number: pr.number, title: pr.title, body: pr.body, state: pr.state, url: prUrl(pr.number),
    baseRefName: pr.base, headRefName: pr.head, headRefOid: pr.headRefOid || remoteHead(pr.head),
    isDraft: !!pr.draft, mergeable: "MERGEABLE",
    mergeStateStatus: pr.state !== "OPEN" ? "UNKNOWN" : checksDone(pr) || !(state.required_checks || []).length ? "CLEAN" : "BLOCKED",
    reviewDecision: "", autoMergeRequest: pr.autoMerge ? { mergeMethod: pr.autoMerge } : null,
    statusCheckRollup: (state.checks || []).map((c) => checksDone(pr)
      ? { name: c, status: "COMPLETED", conclusion: "SUCCESS" } : { name: c, status: "IN_PROGRESS", conclusion: "" }),
    mergedAt: pr.state === "MERGED" ? "2026-11-06T12:00:00Z" : null, closed: pr.state !== "OPEN",
    mergeCommit: pr.mergeCommit ? { oid: pr.mergeCommit } : null,
    author: { login: "eval-bot" }, labels: [], files: [], commits: [],
  };
}

// CI on a PR is pending until someone runs `gh pr checks --watch`, which "waits"
// for it to pass. Passing checks merge a PR whose auto-merge is armed, like GitHub.
const checksDone = (pr) => state.checks_state !== "pending" || !!pr.checksDone;
function completeChecks(pr) {
  pr.checksDone = true;
  if (pr.autoMerge && pr.state === "OPEN") land(pr);
}

// Squash-merge like GitHub: one commit on the base with the head's tree, then
// delete the head branch.
function land(pr) {
  const remote = git("remote", "get-url", "origin");
  const g = (...a) => execFileSync("git", ["-C", remote, ...a], { encoding: "utf8" }).trim();
  const tree = g("rev-parse", `${pr.head}^{tree}`);
  const commit = g("commit-tree", tree, "-p", pr.base, "-m", `${pr.title} (#${pr.number})`);
  g("update-ref", `refs/heads/${pr.base}`, commit);
  g("update-ref", "-d", `refs/heads/${pr.head}`);
  pr.state = "MERGED"; pr.mergeCommit = commit;
}

function findPr(sel) {
  if (sel === undefined) {
    const b = currentBranch();
    return state.prs.find((p) => p.head === b && p.state === "OPEN") || state.prs.find((p) => p.head === b);
  }
  const m = String(sel).match(/(\d+)$/);
  if (/^#?\d+$/.test(sel) || (m && sel.includes("/pull/"))) return state.prs.find((p) => p.number === Number(m[1]));
  return state.prs.find((p) => p.head === sel && p.state === "OPEN") || state.prs.find((p) => p.head === sel);
}

function readBody(p) {
  const file = p.get("-F", "--body-file");
  if (file === "-") { stdinText = readStdin(); return stdinText; }
  if (file) {
    try { return fs.readFileSync(path.resolve(process.cwd(), file), "utf8"); }
    catch { return finish(1, "", `failed to read file ${file}: open ${file}: no such file or directory`); }
  }
  return p.get("-b", "--body");
}

function help(cmd) {
  const extra = cmd.startsWith("pr create") || cmd.startsWith("pr edit") || cmd.startsWith("pr comment")
    ? "\n  -a, --attach file        Attach a file and reference it in the body"
    : cmd.startsWith("issue create") ? "\n  -l, --label name         Add labels by name\n      --parent number      Add the new issue as a sub-issue of the specified parent number or URL\n      --blocked-by numbers Mark the new issue as blocked by these issue numbers or URLs\n      --blocking numbers   Mark the new issue as blocking these issue numbers or URLs\n      --type name          Set the issue type by name"
    : cmd.startsWith("issue edit") ? "\n      --add-label name     Add labels by name\n      --parent number      Set the parent issue by number or URL\n      --add-blocked-by number  Add 'blocked by' relationships by issue number or URL\n      --add-blocking number    Add 'blocking' relationships by issue number or URL" : "";
  return finish(0, `Usage: gh ${cmd} [flags]\n\nFLAGS${extra}\n  (fake gh for evals: common flags accepted)`);
}

// Issues live in state.issues, keyed by number: {title, body, state, labels, comments,
// parent, blockedBy}. Issues filed during the run also get `filed`, their order.
state.issues = state.issues || {};
const issueUrl = (n) => `${repoUrl}/issues/${n}`;
const issueNum = (sel) => String(sel || "").replace(/^#/, "").replace(/.*\/issues\//, "");
const splitList = (vals) => vals.flatMap((v) => String(v).split(",")).map((s) => s.trim()).filter(Boolean);
const labelJson = (name) => {
  const l = (state.labels || []).find((x) => x.name === name) || {};
  return { name, description: l.description || "", color: l.color || "ededed" };
};
const nodes = (ns) => ({ nodes: ns.map(issueRef), totalCount: ns.length });
const issueRef = (n) => { const is = state.issues[n]; return { number: Number(n), title: is.title, url: issueUrl(n), state: is.state || "OPEN" }; };
function issueJson(n) {
  const is = state.issues[n];
  const others = Object.keys(state.issues);
  return {
    number: Number(n), title: is.title, body: is.body, state: is.state || "OPEN", url: issueUrl(n),
    labels: (is.labels || []).map(labelJson), author: { login: is.author || "eval-bot" },
    comments: (is.comments || []).map((c) => ({ author: { login: "eval-bot" }, body: c.body })),
    createdAt: is.createdAt || "2026-11-01T12:00:00Z", closedAt: is.state === "CLOSED" ? "2026-11-02T12:00:00Z" : null,
    parent: is.parent ? issueRef(is.parent) : null,
    subIssues: nodes(others.filter((k) => String(state.issues[k].parent) === String(n))),
    blockedBy: nodes((is.blockedBy || []).filter((k) => state.issues[k])),
    blocking: nodes(others.filter((k) => (state.issues[k].blockedBy || []).map(String).includes(String(n)))),
  };
}
function requireIssue(sel) {
  const n = issueNum(sel);
  if (!state.issues[n]) finish(1, "", `GraphQL: Could not resolve to an issue or pull request with the number of ${n}. (repository.issue)`);
  return n;
}
function requireLabels(labels) {
  const known = new Set((state.labels || []).map((l) => l.name));
  for (const l of labels) if (!known.has(l)) finish(1, "", `could not add label: '${l}' not found`);
}
// Like GitHub search: every term must match (crudely stemmed); is:, state: and label: filter.
const STOP = new Set(["a", "an", "the", "of", "to", "in", "on", "for", "and", "or", "is", "it", "with", "when", "be"]);
const stem = (w) => w.replace(/(ing|ed|es|s|e)$/, "");
const words = (s) => String(s).toLowerCase().split(/[^a-z0-9]+/).filter((w) => w && !STOP.has(w)).map(stem);
function searchIssues(query, st) {
  let wantState = st, labels = [];
  const phrases = [], terms = [];
  for (const t of String(query || "").match(/"[^"]*"|\S+/g) || []) {
    const q = t.match(/^(is|state|label|in|sort|type|repo|no|author):(.*)$/i);
    if (q) {
      const v = q[2].replace(/"/g, "").toLowerCase();
      if (/^(is|state)$/i.test(q[1]) && /^(open|closed)$/.test(v)) wantState = v.toUpperCase();
      if (/^label$/i.test(q[1])) labels.push(v);
    } else if (t.startsWith('"')) phrases.push(t.slice(1, -1).toLowerCase());
    else if (!/^(AND|OR|NOT)$/.test(t)) terms.push(...words(t));
  }
  return Object.keys(state.issues).sort((a, b) => b - a).filter((n) => {
    const is = state.issues[n];
    const text = `${is.title}\n${is.body}\n${(is.comments || []).map((c) => c.body).join("\n")}`;
    const have = new Set(words(text));
    return (wantState === "ALL" || (is.state || "OPEN") === wantState)
      && labels.every((l) => (is.labels || []).some((x) => x.toLowerCase() === l))
      && terms.every((w) => have.has(w)) && phrases.every((ph) => text.toLowerCase().includes(ph));
  });
}
function nextIssueNumber() {
  const used = Object.keys(state.issues).map(Number).concat(state.prs.map((x) => x.number), [state.next_pr - 1]);
  const n = Math.max(0, ...used) + 1;
  if (state.next_pr <= n) state.next_pr = n + 1;
  return n;
}

const [group, sub, ...rest] = argv;
const p = parse(argv.slice(2));
if (argv.includes("--help") || argv.includes("-h") || group === "help") help(argv.filter((a) => !a.startsWith("-")).join(" "));
if (group === "--version" || group === "version") finish(0, "gh version 2.83.0 (2026-10-01)");

// Fake CI, for scenarios whose state.json has a "ci" key (babysit-pr, recall):
//   "ci": { "checks": { "<name>": "<shell command>" }, "flaky": { "<name>": <failures> },
//           "delay": <seconds a run stays pending unless someone watches it>,
//           "head_lag": <seconds a PR keeps showing its old head after its branch moves>, "remote": "<bare repo>",
//           "step_names": { "<name>": "<label the log shows instead of the command>" }, "list_rollup": <true for checks in pr list> }
// Each commit gets one workflow run, created when first asked about. Its jobs run their command
// on that commit's tree, so a fix that works turns the check green. A flaky check fails its first
// <failures> runs with a network error. Runs are kept in state.ci_runs.
if (group === "pr" && sub === "checkout") {
  const pr = findPr(p.pos[0]);
  if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
  const run = (...a) => spawnSync("git", a, { encoding: "utf8" });
  run("fetch", "-q", "origin");
  const local = run("rev-parse", "--verify", "-q", `refs/heads/${pr.head}`).status === 0;
  const r = local ? run("checkout", pr.head) : run("checkout", "-b", pr.head, "--track", `origin/${pr.head}`);
  if (r.status !== 0) finish(1, "", r.stderr);
  if (local) { const m = run("merge", "--ff-only", `origin/${pr.head}`); if (m.status !== 0) finish(1, "", m.stderr); }
  finish(0, "", `Switched to branch '${pr.head}'`);
}
if (state.ci) {
  const ci = state.ci;
  state.ci_runs = state.ci_runs || [];
  const now = () => Math.floor(Date.now() / 1000);
  const remotePath = ci.remote || git("remote", "get-url", "origin");
  const rg = (...a) => spawnSync("git", ["-C", remotePath, ...a], { encoding: "utf8" });
  const resolve = (ref) => { const r = rg("rev-parse", "--verify", "-q", `${ref}^{commit}`); return r.status === 0 ? r.stdout.trim() : ""; };
  const iso = (t) => new Date(t * 1000).toISOString().replace(/\.\d+Z$/, "Z");
  for (const f of ["--branch", "--commit", "--job", "-j", "--workflow", "-w", "--event", "-e", "--status", "--user", "-u"]) VALUE_FLAGS.add(f);
  const q = parse(argv.slice(2));

  const runJob = (job, sha) => {
    if ((ci.flaky || {})[job.name] > 0) {
      ci.flaky[job.name]--;
      return { conclusion: "failure", log: [["Set up job", "Requested labels: ubuntu-latest"],
        ["Run actions/setup-node@v4", "Attempting to download 24.x..."],
        ["Run actions/setup-node@v4", "##[error]read ECONNRESET"],
        ["Run actions/setup-node@v4", "##[error]Process completed with exit code 1."]] };
    }
    const dir = fs.mkdtempSync(path.join(require("os").tmpdir(), "fake-ci-"));
    try {
      try { execFileSync("sh", ["-c", `git -C "$0" archive "$1" | tar -x -C "$2"`, remotePath, sha, dir], { stdio: "ignore" }); }
      catch { return { conclusion: "failure", log: [["Run actions/checkout@v4", `##[error]fatal: reference is not a tree: ${sha}`]] }; }
      const cmd = ci.checks[job.name];
      const r = spawnSync("sh", ["-c", `${cmd} 2>&1`], { cwd: dir, encoding: "utf8", timeout: 60000 });
      const step = `Run ${(ci.step_names || {})[job.name] || cmd}`;
      const lines = (r.stdout || "").split("\n").filter(Boolean).map((l) => [step, l]);
      if (r.status !== 0) lines.push([step, `##[error]Process completed with exit code ${r.status === null ? 124 : r.status}.`]);
      return { conclusion: r.status === 0 ? "success" : "failure", log: lines };
    } finally { fs.rmSync(dir, { recursive: true, force: true }); }
  };
  const settle = (run, force) => {
    if (!force && now() - run.started < (ci.delay === undefined ? 30 : ci.delay)) return run;
    for (const job of run.jobs) if (job.status !== "completed") Object.assign(job, { status: "completed", completed: now() }, runJob(job, run.sha));
    return run;
  };
  const runFor = (sha, branch, event, done) => {
    let run = state.ci_runs.filter((r) => r.sha === sha).pop();
    if (!run) {
      const id = 100 + state.ci_runs.length;
      run = { id, sha, branch, event, attempt: 1, started: done ? now() - 600 : now(),
        jobs: Object.keys(ci.checks).map((name, i) => ({ id: id * 10 + i + 1, name, status: "queued", attempts: 1 })) };
      state.ci_runs.push(run);
    }
    return run;
  };
  // GitHub shows a pushed commit a few seconds late; head_lag emulates that, timed from the remote's reflog.
  const prHead = (pr) => {
    const entries = rg("reflog", "show", "--date=unix", "--format=%H %gd", `refs/heads/${pr.head}`).stdout.trim().split("\n")
      .map((l) => l.match(/^(\w+) .*@\{(\d+)\}$/)).filter(Boolean).map((m) => ({ sha: m[1], t: Number(m[2]) }));
    const settled = entries.find((e) => now() - e.t >= (ci.head_lag || 0));
    return (settled || entries[entries.length - 1] || {}).sha || resolve(pr.head);
  };
  const prRun = (pr, force) => {
    const sha = prHead(pr);
    return sha ? settle(runFor(sha, pr.head, "pull_request"), force) : { id: 0, sha: "", started: 0, jobs: [] };
  };
  const jobUrl = (run, job) => `${repoUrl}/actions/runs/${run.id}/job/${job.id}`;
  const bucket = (job) => job.status !== "completed" ? "pending" : job.conclusion === "success" ? "pass" : "fail";
  const runStatus = (run) => run.jobs.every((j) => j.status === "completed") ? "completed" : "in_progress";
  const runConclusion = (run) => runStatus(run) !== "completed" ? "" : run.jobs.some((j) => j.conclusion !== "success") ? "failure" : "success";
  const runJson = (run) => ({ databaseId: run.id, number: run.id, attempt: run.attempt, name: "CI", workflowName: "CI",
    displayTitle: "CI", headBranch: run.branch, headSha: run.sha, event: run.event, status: runStatus(run),
    conclusion: runConclusion(run), url: `${repoUrl}/actions/runs/${run.id}`, createdAt: iso(run.started), updatedAt: iso(run.started),
    jobs: run.jobs.map((j) => ({ databaseId: j.id, name: j.name, status: j.status, conclusion: j.conclusion || "", url: jobUrl(run, j) })) });
  const compare = (base, head) => {
    const b = resolve(base), h = resolve(head);
    if (!b || !h) return null;
    const [behind, ahead] = rg("rev-list", "--left-right", "--count", `${b}...${h}`).stdout.trim().split(/\s+/).map(Number);
    const status = !ahead && !behind ? "identical" : !behind ? "ahead" : !ahead ? "behind" : "diverged";
    return { status, ahead_by: ahead, behind_by: behind, total_commits: ahead,
      base_commit: { sha: b }, merge_base_commit: { sha: rg("merge-base", b, h).stdout.trim() } };
  };
  const conflicts = (pr) => rg("merge-tree", "--write-tree", pr.base, pr.head).status === 1;
  const prOrFail = () => { const pr = findPr(p.pos[0]); if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`); return pr; };

  if (group === "pr" && sub === "checks") {
    const pr = prOrFail();
    const run = prRun(pr, p.has("--watch"));
    const checks = run.jobs.map((j) => ({ name: j.name, state: j.status !== "completed" ? "IN_PROGRESS" : j.conclusion.toUpperCase(),
      bucket: bucket(j), workflow: "CI", event: run.event, link: jobUrl(run, j), description: "",
      startedAt: iso(run.started), completedAt: j.completed ? iso(j.completed) : "0001-01-01T00:00:00Z" }));
    if (q.get("--json") !== undefined || q.get("--jq", "-q") !== undefined) emit(p, checks);
    const n = (b) => checks.filter((c) => c.bucket === b).length;
    const text = checks.map((c) => `${c.name}\t${c.bucket}\t${c.bucket === "pending" ? "0" : "41s"}\t${c.link}`).join("\n")
      + (n("fail") ? `\n\nSome checks were not successful\n${n("fail")} failing, ${n("pass")} successful, 0 skipped, and ${n("pending")} pending checks`
        : n("pending") ? `\n\nSome checks are still pending\n0 failing, ${n("pass")} successful, 0 skipped, and ${n("pending")} pending checks`
        : "\n\nAll checks were successful");
    finish(n("fail") ? 1 : n("pending") ? 8 : 0, text);
  }
  if (group === "pr" && sub === "view") {
    const pr = prOrFail();
    const v = prJson(pr);
    const run = prRun(pr, false);
    const behind = (compare(pr.base, pr.head) || {}).behind_by;
    v.headRefOid = prHead(pr);
    v.headRepositoryOwner = { login: repo.nameWithOwner.split("/")[0] };
    v.headRepository = { name: repo.name };
    Object.assign(v, { reviews: [], latestReviews: [], comments: [], reviewRequests: [] });
    v.statusCheckRollup = run.jobs.map((j) => ({ __typename: "CheckRun", name: j.name, workflowName: "CI",
      status: j.status === "completed" ? "COMPLETED" : "IN_PROGRESS", conclusion: (j.conclusion || "").toUpperCase(), detailsUrl: jobUrl(run, j) }));
    v.mergeable = pr.state !== "OPEN" ? "UNKNOWN" : conflicts(pr) ? "CONFLICTING" : "MERGEABLE";
    v.mergeStateStatus = pr.state !== "OPEN" ? "UNKNOWN" : v.mergeable === "CONFLICTING" ? "DIRTY"
      : runConclusion(run) !== "success" ? "BLOCKED" : behind ? "BEHIND" : "CLEAN";
    emit(p, v, `${v.title} ${repo.nameWithOwner}#${v.number}\n${v.state} • eval-bot wants to merge into ${v.baseRefName} from ${v.headRefName}\n\n${v.body}\n\nView this pull request on GitHub: ${v.url}`);
  }
  // With ci.list_rollup set (recall), `pr list` reports each open PR's CI like `pr view` does.
  if (group === "pr" && sub === "list" && ci.list_rollup) {
    const st = (p.get("-s", "--state") || "open").toUpperCase();
    let list = state.prs.filter((x) => st === "ALL" || x.state === st);
    if (p.get("-H", "--head")) list = list.filter((x) => x.head === p.get("-H", "--head"));
    if (p.get("-B", "--base")) list = list.filter((x) => x.base === p.get("-B", "--base"));
    const s = p.get("-S", "--search");
    if (s) list = list.filter((x) => (x.title + " " + x.body).toLowerCase().includes(String(s).toLowerCase()));
    const v = list.map((pr) => {
      const x = prJson(pr);
      if (pr.state !== "OPEN") return { ...x, statusCheckRollup: [] };
      const run = prRun(pr, false);
      x.headRefOid = prHead(pr);
      x.statusCheckRollup = run.jobs.map((j) => ({ __typename: "CheckRun", name: j.name, workflowName: "CI",
        status: j.status === "completed" ? "COMPLETED" : "IN_PROGRESS", conclusion: (j.conclusion || "").toUpperCase(), detailsUrl: jobUrl(run, j) }));
      x.mergeStateStatus = runConclusion(run) === "success" ? "CLEAN" : "BLOCKED";
      return x;
    });
    emit(p, v, v.map((x) => `${x.number}\t${x.title}\t${x.headRefName}\t${x.isDraft ? "DRAFT" : x.state}`).join("\n") || "no pull requests match your search");
  }
  if (group === "pr" && sub === "update-branch") {
    const pr = prOrFail();
    if (p.has("--rebase")) finish(1, "", "fake-gh: --rebase is not available in this environment");
    const head = resolve(pr.head), base = resolve(pr.base);
    if (rg("merge-base", "--is-ancestor", base, head).status === 0) finish(0, "✓ PR branch already up-to-date");
    const tree = rg("merge-tree", "--write-tree", head, base);
    if (tree.status !== 0) finish(1, "", "X Cannot update PR branch due to conflicts");
    const commit = rg("commit-tree", tree.stdout.trim().split("\n")[0], "-p", head, "-p", base, "-m", `Merge branch '${pr.base}' into ${pr.head}`).stdout.trim();
    rg("update-ref", "-m", "update-branch", `refs/heads/${pr.head}`, commit, head);
    finish(0, "✓ PR branch updated");
  }
  if (group === "run") {
    const byId = (id) => state.ci_runs.find((r) => String(r.id) === String(id));
    if (sub === "list") {
      const branch = q.get("-b", "--branch"), commit = q.get("--commit");
      if (branch && !commit) { const sha = resolve(branch); if (sha) settle(runFor(sha, branch, branch === repo.default_branch ? "push" : "pull_request", true), false); }
      for (const pr of state.prs.filter((x) => x.state === "OPEN")) settle(runFor(prHead(pr), pr.head, "pull_request"), false);
      let runs = state.ci_runs.slice().reverse();
      if (branch) runs = runs.filter((r) => r.branch === branch);
      if (commit) runs = runs.filter((r) => r.sha.startsWith(commit));
      const v = runs.slice(0, Number(q.get("-L", "--limit") || 20)).map(runJson);
      emit(q, v, v.map((r) => `${r.status}\t${r.conclusion}\t${r.displayTitle}\tCI\t${r.headBranch}\t${r.event}\t${r.databaseId}\t41s\t${r.createdAt}`).join("\n") || "no runs found");
    }
    const id = q.pos[0] || (q.get("--job", "-j") && (state.ci_runs.find((r) => r.jobs.some((j) => String(j.id) === String(q.get("--job", "-j")))) || {}).id);
    if (!id && ["view", "rerun", "watch"].includes(sub)) finish(1, "", "run or job ID required when not running interactively");
    const run = byId(id);
    if (!run && ["view", "rerun", "watch"].includes(sub)) finish(1, "", `could not find any workflow run with ID ${id}`);
    if (sub === "view") {
      settle(run, false);
      const jobArg = q.get("--job", "-j");
      const jobs = run.jobs.filter((j) => !jobArg || String(j.id) === String(jobArg));
      const logOf = (js) => js.flatMap((j) => j.log.map(([step, line]) => `${j.name}\t${step}\t${iso(j.completed)} ${line}`)).join("\n");
      if (q.has("--log-failed")) finish(0, logOf(jobs.filter((j) => j.status === "completed" && j.conclusion !== "success")));
      if (q.has("--log")) {
        if (runStatus(run) !== "completed") finish(1, "", "run is still in progress; logs will be available when it is complete");
        finish(0, logOf(jobs));
      }
      const mark = (j) => j.status !== "completed" ? "*" : j.conclusion === "success" ? "✓" : "X";
      const failed = run.jobs.filter((j) => bucket(j) === "fail");
      emit(q, runJson(run), `${runStatus(run) === "completed" ? (runConclusion(run) === "success" ? "✓" : "X") : "*"} ${run.branch} CI · ${run.id}\n`
        + `Triggered via ${run.event}${run.attempt > 1 ? ` (attempt #${run.attempt})` : ""}\n\nJOBS\n`
        + run.jobs.map((j) => `${mark(j)} ${j.name}${j.status === "completed" ? " in 41s" : ""} (ID ${j.id})`).join("\n")
        + (failed.length ? `\n\nANNOTATIONS\n${failed.map((j) => `X Process completed with exit code 1.\n${j.name}: .github#1`).join("\n")}\n\nTo see what failed, try: gh run view ${run.id} --log-failed` : "")
        + `\nView this run on GitHub: ${repoUrl}/actions/runs/${run.id}`);
    }
    if (sub === "rerun") {
      if (runStatus(run) !== "completed") finish(1, "", `run ${run.id} cannot be rerun; it is still in progress`);
      const jobArg = q.get("--job", "-j");
      const again = run.jobs.filter((j) => jobArg ? String(j.id) === String(jobArg) : q.has("--failed") ? j.conclusion !== "success" : true);
      if (!again.length) finish(1, "", `run ${run.id} has no failed jobs to rerun`);
      for (const j of again) { j.status = "queued"; j.conclusion = ""; j.completed = 0; j.attempts++; }
      run.attempt++; run.started = now();
      finish(0, `✓ Requested rerun${q.has("--failed") ? " (failed jobs)" : ""} of run ${run.id}`);
    }
    if (sub === "watch") {
      settle(run, true);
      const ok = runConclusion(run) === "success";
      finish(q.has("--exit-status") && !ok ? 1 : 0, `${ok ? "✓" : "X"} ${run.branch} CI · ${run.id}\nRun CI (${run.id}) completed with '${runConclusion(run)}'`);
    }
  }
  if (group === "api") {
    const q = parse(argv.slice(1));
    const ep = (q.pos[0] || "").replace(/^\//, "").replace("{owner}/{repo}", repo.nameWithOwner).split("?")[0];
    const base = `repos/${repo.nameWithOwner}`;
    const out = (v) => {
      const jq = q.get("--jq", "-q");
      if (!jq) finish(0, JSON.stringify(v, null, 2));
      const r = spawnSync("jq", ["-r", jq], { input: JSON.stringify(v), encoding: "utf8" });
      finish(r.status === 0 ? 0 : 1, r.stdout.replace(/\n$/, ""), r.status === 0 ? "" : r.stderr);
    };
    let m;
    if (new RegExp(`^${base}/(pulls/\\d+/(comments|reviews)|issues/\\d+/comments)$`).test(ep)) out([]);
    if ((m = ep.match(new RegExp(`^${base}/git/ref/heads/(.+)$`)))) {
      const sha = resolve(decodeURIComponent(m[1]));
      if (!sha) finish(1, "", "gh: Not Found (HTTP 404)");
      out({ ref: `refs/heads/${decodeURIComponent(m[1])}`, object: { sha, type: "commit" } });
    }
    if ((m = ep.match(new RegExp(`^${base}/compare/(.+?)\\.\\.\\.(.+)$`)))) {
      const v = compare(decodeURIComponent(m[1]), decodeURIComponent(m[2]));
      if (!v) finish(1, "", "gh: Not Found (HTTP 404)");
      out(v);
    }
    if ((m = ep.match(new RegExp(`^${base}/commits/(.+)/(check-runs|status)$`)))) {
      const ref = decodeURIComponent(m[1]); const sha = resolve(ref);
      if (!sha) finish(1, "", "gh: No commit found for SHA: " + ref + " (HTTP 422)");
      const pr = state.prs.find((x) => x.state === "OPEN" && prHead(x) === sha);
      const run = settle(runFor(sha, pr ? pr.head : ref, pr ? "pull_request" : "push", !pr), false);
      const runs = run.jobs.map((j) => ({ id: j.id, name: j.name, head_sha: sha, status: j.status === "completed" ? "completed" : "in_progress",
        conclusion: j.conclusion || null, html_url: jobUrl(run, j) }));
      if (m[2] === "check-runs") out({ total_count: runs.length, check_runs: runs });
      out({ state: runConclusion(run) || "pending", sha, total_count: 0, statuses: [] });
    }
  }
}

// state.local_stack is the clone's tracked stack {trunk, branches}; state.stacks are the GitHub stacks {number, prs}; gh stack needs github/gh-stack in state.extensions.
state.extensions = state.extensions || [];
state.stacks = state.stacks || [];
const stacksOn = () => state.stacks_enabled !== false;
const stackOf = (n) => state.stacks.find((s) => s.prs.includes(n));
if (group === "extension") {
  if (sub === "list" || sub === "ls") finish(0, state.extensions.map((e) => `gh ${e.split("/")[1].replace(/^gh-/, "")}\t${e}\tv0.3.0`).join("\n"));
  if (sub === "install") {
    if (p.pos[0] !== "github/gh-stack") finish(1, "", `fake-gh: only github/gh-stack can be installed here`);
    if (!state.extensions.includes(p.pos[0])) state.extensions.push(p.pos[0]);
    finish(0, "", "✓ Installed extension github/gh-stack");
  }
}
if (group === "stack") {
  if (!state.extensions.includes("github/gh-stack")) finish(1, "", `unknown command "stack" for "gh"`);
  const trunk = repo.default_branch;
  const exists = (b) => git("rev-parse", "--verify", "-q", `refs/heads/${b}`) !== "";
  const pushAll = (bs) => {
    const r = spawnSync("git", ["push", "-q", "--force-with-lease", "origin", ...bs.map((b) => `${b}:refs/heads/${b}`)], { encoding: "utf8" });
    if (r.status !== 0) finish(1, "", `✗ push failed\n${r.stderr}`);
  };
  const requireLocal = () => { if (!state.local_stack) finish(2, "", `✗ current branch "${currentBranch()}" is not part of a stack`); return state.local_stack; };
  const linkPrs = (prs, open) => {
    prs.forEach((pr, i) => { pr.base = i === 0 ? (p.get("--base") || trunk) : prs[i - 1].head; if (open) pr.draft = false; });
    if (prs.length < 2) return "";
    if (!stacksOn()) finish(9, "", "✗ Stacked PRs are not enabled for this repository");
    let st = prs.map((x) => stackOf(x.number)).find(Boolean);
    if (!st) { st = { number: state.next_pr++, prs: [] }; state.stacks.push(st); }
    for (const pr of prs) if (!st.prs.includes(pr.number)) st.prs.push(pr.number);
    return `✓ Stack #${st.number}: ${st.prs.map((n) => "#" + n).join(" <- ")}\n${prs.map((x) => prUrl(x.number)).join("\n")}`;
  };
  const prFor = (b, open) => {
    let pr = state.prs.find((x) => x.head === b && x.state === "OPEN");
    if (!pr) {
      pr = { number: state.next_pr++, title: git("log", "-1", "--format=%s", b), body: "", base: trunk, head: b,
        headRefOid: remoteHead(b), draft: !open, state: "OPEN", attachments: [] };
      state.prs.push(pr);
    }
    return pr;
  };
  switch (sub) {
    case "init": {
      if (!p.pos.length) finish(5, "", "✗ branch names are required when not running interactively");
      let prev = p.get("--base", "-b") || trunk;
      for (const b of p.pos) { if (!exists(b)) git("branch", b, prev); prev = b; }
      state.local_stack = { trunk: p.get("--base", "-b") || trunk, branches: [...p.pos] };
      git("checkout", "-q", p.pos[p.pos.length - 1]);
      finish(0, "", `✓ Stack initialized: (${state.local_stack.trunk}) <- ${p.pos.join(" <- ")}`);
    }
    case "add": {
      const ls = requireLocal();
      const b = p.pos[0];
      if (!b) finish(5, "", "✗ a branch name is required when not running interactively");
      if (git("rev-parse", "--verify", "-q", `refs/heads/${b}`) !== "") finish(1, "", `✗ branch ${b} already exists`);
      spawnSync("git", ["checkout", "-q", "-b", b], { encoding: "utf8" });
      if (p.has("-A", "--all")) git("add", "-A"); else if (p.has("-u", "--update")) git("add", "-u");
      const msg = p.get("-m", "--message"); if (msg) spawnSync("git", ["commit", "-q", "-m", msg], { encoding: "utf8" });
      ls.branches.push(b);
      finish(0, "", `✓ Added ${b} to the stack`);
    }
    case "push": { const ls = requireLocal(); pushAll(ls.branches); finish(0, "", `✓ Pushed ${ls.branches.length} branches`); }
    case "submit": {
      const ls = requireLocal();
      if (!p.has("--auto")) finish(1, "", "✗ the submit editor needs an interactive terminal; pass --auto");
      pushAll(ls.branches);
      finish(0, linkPrs(ls.branches.map((b) => prFor(b, p.has("--open"))), p.has("--open")));
    }
    case "link": {
      if (p.pos.length < 2) finish(5, "", "✗ link needs at least two branches or PRs, bottom first");
      const branches = p.pos.filter((a) => !/^#?\d+$/.test(a) && !a.includes("/pull/"));
      if (branches.length) pushAll(branches);
      const prs = p.pos.map((a) => (/^#?\d+$/.test(a) || a.includes("/pull/")) ? findPr(a) : prFor(a, p.has("--open")));
      if (prs.some((x) => !x)) finish(4, "", "✗ a PR in the list does not exist");
      finish(0, linkPrs(prs, p.has("--open")));
    }
    case "view": {
      const ls = requireLocal();
      const cur = currentBranch();
      const v = { trunk: ls.trunk, currentBranch: cur, branches: ls.branches.map((b) => {
        const pr = state.prs.find((x) => x.head === b && x.state !== "CLOSED");
        return { name: b, head: git("rev-parse", b), base: "", isCurrent: b === cur, isMerged: !!pr && pr.state === "MERGED",
          isQueued: false, needsRebase: false, ...(pr ? { pr: { number: pr.number, url: prUrl(pr.number), state: pr.state } } : {}) };
      }) };
      if (p.has("--json")) finish(0, JSON.stringify(v, null, 2));
      finish(0, `(${ls.trunk}) <- ${ls.branches.join(" <- ")}`);
    }
    case "rebase": case "sync": { requireLocal(); finish(0, "", sub === "sync" ? "✓ Stack synced" : "✓ Stack rebased"); }
    case "merge": {
      const target = p.pos[0] ? findPr(p.pos[0]) || null : findPr();
      const st = target ? stackOf(target.number) : state.stacks.find((s) => s.number === Number(p.pos[0]));
      if (!st) finish(2, "", "✗ no stack found for that PR or stack number");
      if (!p.has("--yes", "-y")) finish(1, "", "✗ the merge wizard needs an interactive terminal; pass --yes");
      const upto = target ? st.prs.indexOf(target.number) : st.prs.length - 1;
      const batch = st.prs.slice(0, upto + 1).map((n) => state.prs.find((x) => x.number === n)).filter((x) => x.state === "OPEN");
      for (const pr of batch) {
        if (pr.draft) finish(1, "", `✗ #${pr.number} is a draft`);
        if ((state.required_checks || []).length && !checksDone(pr))
          finish(1, "", `✗ Merge failed: #${pr.number} does not meet its merge requirements: required status checks have not passed. Nothing was merged.`);
      }
      for (const pr of batch) { pr.base = trunk; land(pr); }
      const next = st.prs.map((n) => state.prs.find((x) => x.number === n)).find((x) => x.state === "OPEN");
      if (next) next.base = trunk;
      finish(0, `✓ Merged ${batch.map((x) => "#" + x.number).join(", ")} into ${trunk}`);
    }
  }
  finish(1, "", `fake-gh: unsupported command "gh ${argv.join(" ")}"`);
}

switch (group) {
  case "auth":
    if (sub === "status") finish(0, "github.com\n  ✓ Logged in to github.com account eval-bot (keyring)\n  - Token scopes: 'repo', 'workflow'");
    finish(0, "");
  case "repo": {
    if (sub !== "view") break;
    const v = { name: repo.name, nameWithOwner: repo.nameWithOwner, owner: { login: repo.nameWithOwner.split("/")[0] },
      defaultBranchRef: { name: repo.default_branch }, visibility: repo.visibility || "PUBLIC",
      isPrivate: repo.visibility === "PRIVATE", url: repoUrl, description: repo.description || "",
      autoMergeAllowed: repo.allow_auto_merge, squashMergeAllowed: repo.allow_squash_merge,
      mergeCommitAllowed: repo.allow_merge_commit, rebaseMergeAllowed: repo.allow_rebase_merge,
      deleteBranchOnMerge: true };
    emit(p, v, `${repo.nameWithOwner}\n${repo.description || ""}`);
  }
  case "api": {
    const pa = parse(argv.slice(1));
    const ep = (pa.pos[0] || "").replace(/^\//, "").replace("{owner}/{repo}", repo.nameWithOwner).split("?")[0];
    const base = `repos/${repo.nameWithOwner}`;
    let v;
    if (ep === base) v = { name: repo.name, full_name: repo.nameWithOwner, default_branch: repo.default_branch,
      allow_auto_merge: repo.allow_auto_merge, allow_squash_merge: repo.allow_squash_merge,
      allow_merge_commit: repo.allow_merge_commit, allow_rebase_merge: repo.allow_rebase_merge,
      delete_branch_on_merge: true, private: repo.visibility === "PRIVATE", visibility: (repo.visibility || "PUBLIC").toLowerCase() };
    else if (ep.startsWith(`${base}/branches/`) && !ep.endsWith("/protection")) {
      const b = decodeURIComponent(ep.slice(`${base}/branches/`.length));
      if (!remoteHead(b)) finish(1, "", "gh: Branch not found (HTTP 404)");
      const req = b === repo.default_branch ? (state.required_checks || []) : [];
      v = { name: b, protected: req.length > 0,
        protection: { enabled: req.length > 0, required_status_checks: { enforcement_level: req.length ? "non_admins" : "off", contexts: req } } };
    } else if (ep.startsWith(`${base}/branches/`) && ep.endsWith("/protection")) {
      const b = decodeURIComponent(ep.slice(`${base}/branches/`.length, -"/protection".length));
      const req = b === repo.default_branch ? (state.required_checks || []) : [];
      if (!req.length) finish(1, "", "gh: Branch not protected (HTTP 404)");
      v = { required_status_checks: { strict: false, contexts: req } };
    } else if (ep.startsWith(`${base}/rules/branches/`)) v = [];
    else if (ep === `${base}/stacks`) {
      if (!stacksOn()) finish(1, "", "gh: Not Found (HTTP 404)");
      v = state.stacks.map((st) => ({ number: st.number, base: { ref: repo.default_branch }, pull_requests: st.prs.map((n) => ({ number: n })) }));
    }
    else if (ep === `${base}/pulls`) v = state.prs.filter((x) => x.state === "OPEN").map((x) => ({ number: x.number, title: x.title, head: { ref: x.head }, base: { ref: x.base }, html_url: prUrl(x.number), draft: !!x.draft }));
    else finish(1, "", `gh: Not Found (HTTP 404)`);
    const jq = pa.get("--jq", "-q");
    if (!jq) finish(0, JSON.stringify(v, null, 2));
    const r = spawnSync("jq", ["-r", jq], { input: JSON.stringify(v), encoding: "utf8" });
    finish(r.status === 0 ? 0 : 1, r.stdout.replace(/\n$/, ""), r.status === 0 ? "" : r.stderr);
  }
  case "issue": {
    const issues = state.issues;
    if (sub === "view") {
      const n = requireIssue(p.pos[0]);
      const is = issues[n], v = issueJson(n);
      const extra = (v.labels.length ? `\nlabels: ${v.labels.map((l) => l.name).join(", ")}` : "")
        + (v.comments.length ? "\n\n" + v.comments.map((c) => `eval-bot commented\n${c.body}`).join("\n\n") : "");
      emit(p, v, `${is.title} ${repo.nameWithOwner}#${n}\n${v.state === "OPEN" ? "Open" : "Closed"}${extra}\n\n${is.body}`);
    }
    if (sub === "list") {
      const st = (p.get("-s", "--state") || "open").toUpperCase();
      const want = p.all("-l", "--label").flatMap((l) => splitList([l]));
      let nums = searchIssues(p.get("-S", "--search"), st)
        .filter((n) => want.every((l) => (issues[n].labels || []).includes(l)));
      if (p.get("-L", "--limit")) nums = nums.slice(0, Number(p.get("-L", "--limit")));
      const list = nums.map(issueJson);
      emit(p, list, list.map((i) => `${i.number}\t${i.state}\t${i.title}${i.labels.length ? "\t" + i.labels.map((l) => l.name).join(", ") : ""}`).join("\n"));
    }
    if (sub === "create") {
      if (p.has("--web", "-w")) finish(1, "", "fake-gh: --web is not available in this environment");
      const title = p.get("-t", "--title"), body = readBody(p);
      if (title === undefined || body === undefined) finish(1, "", "must provide `--title` and `--body` (or `--body-file`) when not running interactively");
      const labels = splitList(p.all("-l", "--label"));
      requireLabels(labels);
      const parent = p.get("--parent") !== undefined ? requireIssue(p.get("--parent")) : undefined;
      const blockedBy = splitList(p.all("--blocked-by")).map(requireIssue);
      const blocking = splitList(p.all("--blocking")).map(requireIssue);
      const n = nextIssueNumber();
      state.issues_filed = (state.issues_filed || 0) + 1;
      issues[n] = { title, body, state: "OPEN", labels, comments: [], filed: state.issues_filed };
      if (parent) issues[n].parent = Number(parent);
      if (blockedBy.length) issues[n].blockedBy = blockedBy.map(Number);
      for (const b of blocking) issues[b].blockedBy = [...new Set((issues[b].blockedBy || []).concat(n))];
      finish(0, issueUrl(n));
    }
    if (sub === "comment") {
      const n = requireIssue(p.pos[0]);
      const body = readBody(p);
      if (body === undefined) finish(1, "", "must provide `--body` or `--body-file` when not running interactively");
      (issues[n].comments = issues[n].comments || []).push({ body });
      state.comments_made = (state.comments_made || 0) + 1;
      finish(0, `${issueUrl(n)}#issuecomment-${state.comments_made}`);
    }
    if (sub === "edit") {
      const nums = (p.pos.length ? p.pos : [undefined]).map(requireIssue);
      const add = splitList(p.all("--add-label"));
      requireLabels(add);
      const body = readBody(p);
      const drop = splitList(p.all("--remove-label"));
      const parent = p.get("--parent") !== undefined ? Number(requireIssue(p.get("--parent"))) : undefined;
      const blockedBy = splitList(p.all("--add-blocked-by")).map(requireIssue).map(Number);
      const blocking = splitList(p.all("--add-blocking")).map(requireIssue);
      for (const n of nums) {
        const is = issues[n];
        if (body !== undefined) is.body = body;
        if (p.get("-t", "--title")) is.title = p.get("-t", "--title");
        is.labels = [...new Set((is.labels || []).concat(add))].filter((l) => !drop.includes(l));
        if (parent !== undefined) is.parent = parent;
        if (p.has("--remove-parent")) delete is.parent;
        if (blockedBy.length) is.blockedBy = [...new Set((is.blockedBy || []).concat(blockedBy))];
        for (const b of blocking) issues[b].blockedBy = [...new Set((issues[b].blockedBy || []).concat(Number(n)))];
      }
      finish(0, nums.map(issueUrl).join("\n"));
    }
    break;
  }
  case "label": {
    if (sub === "list") {
      const list = (state.labels || []).map((l) => ({ ...labelJson(l.name), isDefault: false }));
      emit(p, list, list.map((l) => `${l.name}\t${l.description}\t#${l.color}`).join("\n"));
    }
    if (sub === "create") {
      const name = p.pos[0];
      if (!name) finish(1, "", "cannot create label: name argument required");
      if ((state.labels || []).some((l) => l.name === name)) finish(1, "", `label with name "${name}" already exists; use \`--force\` to update its color and description`);
      (state.labels = state.labels || []).push({ name, description: typeof p.get("--description") === "string" ? p.get("--description") : "", color: "ededed" });
      finish(0, `✓ Label "${name}" created in ${repo.nameWithOwner}`);
    }
    break;
  }
  case "search": {
    if (sub !== "issues") break;
    const st = (p.get("--state") || "all").toUpperCase();
    const want = p.all("--label").flatMap((l) => splitList([l]));
    const nums = searchIssues(p.pos.join(" "), st).filter((n) => want.every((l) => (state.issues[n].labels || []).includes(l)));
    const list = nums.map((n) => ({ ...issueJson(n), state: (state.issues[n].state || "OPEN").toLowerCase(),
      repository: { name: repo.name, nameWithOwner: repo.nameWithOwner }, isPullRequest: false }));
    emit(p, list, list.map((i) => `${repo.nameWithOwner}\t${i.number}\t${i.state}\t${i.title}\t${i.labels.map((l) => l.name).join(", ")}`).join("\n") || "No issues matched your search");
  }
  case "pr": {
    switch (sub) {
      case "create": {
        if (p.has("--web", "-w")) finish(1, "", "fake-gh: --web is not available in this environment");
        const head = p.get("-H", "--head") || currentBranch();
        const base = p.get("-B", "--base") || repo.default_branch;
        const oid = remoteHead(head);
        if (!oid) finish(1, "", `aborted: you must first push the current branch to a remote, or use the --head flag`);
        const dup = state.prs.find((x) => x.head === head && x.state === "OPEN");
        if (dup) finish(1, "", `a pull request for branch "${head}" into branch "${dup.base}" already exists:\n${prUrl(dup.number)}`);
        let title = p.get("-t", "--title");
        let body = readBody(p);
        if (p.has("--fill", "-f")) { title = title || git("log", "-1", "--format=%s"); body = body || git("log", "-1", "--format=%b"); }
        if (title === undefined || body === undefined) finish(1, "", "must provide `--title` and `--body` (or `--fill` or `--body-file`) when not running interactively");
        const number = state.next_pr++;
        state.prs.push({ number, title, body, base, head, headRefOid: oid, draft: p.has("-d", "--draft"), state: "OPEN",
          attachments: p.all("--attach") });
        finish(0, prUrl(number));
      }
      case "list": {
        const st = (p.get("-s", "--state") || "open").toUpperCase();
        let list = state.prs.filter((x) => st === "ALL" || x.state === st);
        if (p.get("-H", "--head")) list = list.filter((x) => x.head === p.get("-H", "--head"));
        if (p.get("-B", "--base")) list = list.filter((x) => x.base === p.get("-B", "--base"));
        const q = p.get("-S", "--search");
        if (q) list = list.filter((x) => (x.title + " " + x.body).includes(q) || (x.headRefOid || "").startsWith(q));
        const v = list.map(prJson);
        emit(p, v, v.map((x) => `${x.number}\t${x.title}\t${x.headRefName}\t${x.state}`).join("\n") || "no pull requests match your search");
      }
      case "view": {
        const pr = findPr(p.pos[0]);
        if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
        const v = prJson(pr);
        emit(p, v, `${v.title} ${repo.nameWithOwner}#${v.number}\n${v.state} • eval-bot wants to merge into ${v.baseRefName} from ${v.headRefName}\n\n${v.body}\n\nView this pull request on GitHub: ${v.url}`);
      }
      case "edit": {
        const pr = findPr(p.pos[0]);
        if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
        const body = readBody(p);
        if (body !== undefined) pr.body = body;
        if (p.get("-t", "--title")) pr.title = p.get("-t", "--title");
        if (p.get("-B", "--base")) pr.base = p.get("-B", "--base");
        pr.attachments = (pr.attachments || []).concat(p.all("--attach"));
        finish(0, prUrl(pr.number));
      }
      case "ready": {
        const pr = findPr(p.pos[0]); if (pr) pr.draft = false;
        finish(0, `✓ Pull request ${repo.nameWithOwner}#${pr ? pr.number : "?"} is marked as "ready for review"`);
      }
      case "merge": {
        const pr = findPr(p.pos[0]);
        if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
        const method = p.has("--squash", "-s") ? "squash" : p.has("--rebase", "-r") ? "rebase" : p.has("--merge", "-m") ? "merge" : null;
        if (!method) finish(1, "", "--merge, --rebase, or --squash required when not running interactively");
        if (p.has("--disable-auto")) { pr.autoMerge = null; finish(0, `✓ Auto-merge disabled for pull request ${repo.nameWithOwner}#${pr.number}`); }
        if (pr.state !== "OPEN") finish(1, "", `Pull request ${repo.nameWithOwner}#${pr.number} was already merged`);
        if (stackOf(pr.number) && p.has("--auto")) finish(1, "", `GraphQL: Auto-merge is not available for pull requests in a stack (enablePullRequestAutoMerge)`);
        if (stackOf(pr.number) && pr.base !== repo.default_branch) finish(1, "", `X Pull request ${repo.nameWithOwner}#${pr.number} is in a stack; merge it with \`gh stack merge ${pr.number}\``);
        const protectedBase = pr.base === repo.default_branch && (state.required_checks || []).length > 0;
        if (p.has("--auto")) {
          if (!repo.allow_auto_merge) finish(1, "", "GraphQL: Auto merge is not allowed for this repository (enablePullRequestAutoMerge)");
          if (!protectedBase || checksDone(pr)) {
            land(pr);
            finish(0, `✓ Squashed and merged pull request ${repo.nameWithOwner}#${pr.number} (${pr.title})`);
          }
          pr.autoMerge = method;
          finish(0, `✓ Pull request ${repo.nameWithOwner}#${pr.number} will be automatically merged via ${method} when all requirements are met`);
        }
        if (protectedBase && !checksDone(pr) && !p.has("--admin"))
          finish(1, "", `X Pull request ${repo.nameWithOwner}#${pr.number} is not mergeable: the base branch policy prohibits the merge.\nTo have the pull request merged after all the requirements have been met, add the \`--auto\` flag.`);
        land(pr);
        finish(0, `✓ Squashed and merged pull request ${repo.nameWithOwner}#${pr.number} (${pr.title})`);
      }
      case "checks": {
        const pr = findPr(p.pos[0]);
        if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
        if (p.has("--watch")) completeChecks(pr);
        const done = checksDone(pr);
        const checks = (state.checks || []).map((c) => ({ name: c, state: done ? "SUCCESS" : "IN_PROGRESS", bucket: done ? "pass" : "pending", workflow: "CI", link: `${repoUrl}/actions/runs/1` }));
        const text = checks.map((c) => `${c.name}\t${c.bucket}\t${done ? "1m2s" : "0"}\t${c.link}`).join("\n")
          + (done ? "\n\nAll checks were successful" : `\n\nSome checks are still pending\n0 failing, 0 successful, 0 skipped, and ${checks.length} pending checks`);
        if (p.get("--json") !== undefined || p.get("--jq", "-q") !== undefined) emit(p, checks);
        finish(done ? 0 : 8, text);
      }
      case "diff": {
        const pr = findPr(p.pos[0]);
        if (!pr) finish(1, "", `no pull requests found for branch "${p.pos[0] || currentBranch()}"`);
        git("fetch", "-q", "origin");
        const args = p.has("--name-only") ? ["--name-only"] : [];
        finish(0, git("diff", ...args, `origin/${pr.base}...origin/${pr.head}`));
      }
      case "comment":
        finish(0, `${prUrl((findPr(p.pos[0]) || {}).number)}#issuecomment-1`);
      case "status":
        finish(0, `Current branch\n  ${(findPr() && "#" + findPr().number) || "There is no pull request associated with [" + currentBranch() + "]"}`);
    }
    break;
  }
  case "release": {
    // Only for scenarios that seed state.releases: [{tagName, name, publishedAt, isLatest, body}].
    if (!state.releases) break;
    const rels = state.releases;
    if (sub === "list") emit(p, rels, rels.map((r) => `${r.name || r.tagName}\t${r.isLatest ? "Latest" : ""}\t${r.tagName}\t${r.publishedAt}`).join("\n") || "no releases found");
    if (sub === "view") {
      const r = p.pos[0] ? rels.find((x) => x.tagName === p.pos[0]) : rels.find((x) => x.isLatest) || rels[0];
      if (!r) finish(1, "", "release not found");
      emit(p, { ...r, url: `${repoUrl}/releases/tag/${r.tagName}` }, `${r.name || r.tagName}\n${r.tagName}\npublished ${r.publishedAt}\n\n${r.body || ""}`);
    }
    break;
  }
  case "run": {
    const runs = [{ databaseId: 1, status: "completed", conclusion: "success", name: "CI", headBranch: currentBranch(), url: `${repoUrl}/actions/runs/1` }];
    if (sub === "list") emit(p, runs, `completed\tsuccess\tCI\t${currentBranch()}\t1`);
    if (sub === "view" || sub === "watch") finish(0, `✓ ${currentBranch()} CI · 1\nTriggered via pull_request\n\nJOBS\n✓ test in 1m2s`);
    break;
  }
}
finish(1, "", `fake-gh: unsupported command "gh ${argv.join(" ")}"`);
