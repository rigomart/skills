#!/usr/bin/env bash
# pr-report: print the report line for each PR, ready to paste into the reply.
#
#   pr-report [<pr>...] [--repo owner/name]
#
# <pr> is a PR's number (7, #7), URL or branch; the current branch's PR when
# none is given. Give a stack's PRs bottom first. Each line:
#   - <url> (<title>): <head> at <sha> into <base>, <state>, auto-merge <off | armed>
#
# Exit codes
#   0  every PR was read
#   2  bad input, or a PR cannot be read (its line says which)
set -uo pipefail

usage="usage: pr-report [<pr>...] [--repo owner/name]"
prs=() repo=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ -n "${2:-}" ] || { echo "pr-report: $usage"; exit 2; }; repo=(--repo "$2"); shift 2 ;;
    -*) echo "pr-report: unknown argument '$1'. $usage"; exit 2 ;;
    \#[0-9]*) prs+=("${1#\#}"); shift ;;
    *) prs+=("$1"); shift ;;
  esac
done
[ ${#prs[@]} -gt 0 ] || prs=("")

status=0
for pr in "${prs[@]}"; do
  line=$(gh pr view ${pr:+"$pr"} ${repo[@]+"${repo[@]}"} --json url,title,headRefName,headRefOid,baseRefName,state,isDraft,autoMergeRequest --jq '
    "- \(.url) (\(.title)): \(.headRefName) at \(.headRefOid[0:7]) into \(.baseRefName), "
    + (if .state == "OPEN" then (if .isDraft then "draft" else "open" end) else (.state | ascii_downcase) end)
    + ", auto-merge " + (if .autoMergeRequest then "armed" else "off" end)' 2>&1)
  if [ $? -eq 0 ] && [ -n "$line" ]; then echo "$line"; else echo "- ${pr:-current branch}: cannot read PR: ${line:-no output}"; status=2; fi
done
exit $status
